{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "digital-bypass",
  "version": "0.2.0",
  "identifier": "dev.digitalbombyx.digitalbypass",
  "build": {
    "beforeDevCommand": "npm run sync-zapret && npm run sync-tor && npm run sync-xray && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run sync-zapret && npm run sync-tor && npm run sync-xray && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "digital-bypass",
        "width": 1140,
        "height": 750,
        "minWidth": 460,
        "minHeight": 520,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "center": true,
        "visible": false,
        "backgroundColor": "#000000",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "digital-bombyx",
    "category": "Utility",
    "shortDescription": "Network unblocking multitool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": { "zapret/": "zapret/", "tor/": "tor/", "xray/": "xray/", "../LICENSE": "LICENSE", "../NOTICE": "NOTICE" },
    "licenseFile": "../LICENSE",
    "windows": { "nsis": { "installerIcon": "icons/icon.ico" } }
  }
}
